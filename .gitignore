node_modules
dist
.vite
*.local
.DS_Store

# Runtime logs — live trading writes here, never commit
logs/
*.log
*.jsonl

# Secrets — NEVER commit
.env
.env.local
.env.*.local
.KILL

# Recorded market data — grows to GBs on the collector VPS.
# Anchored with a leading slash: an unanchored `data/` also matches
# src/data/, which silently excluded a new source module.
/data/
!/data/.gitkeep

# Backtest output
/reports/

# Patch files handed between machines
*.patch

# Editor/manual backups
*.bak
*.orig
