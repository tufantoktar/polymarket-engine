{
  "name": "polymarket-engine",
  "private": true,
  "version": "5.8.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "live:paper": "TRADING_MODE=paper node scripts/runLive.js",
    "live": "TRADING_MODE=live node scripts/runLive.js",
    "trades": "node scripts/tradeHistory.js",
    "trades:all": "node scripts/tradeHistory.js --all",
    "install:live": "npm install @polymarket/clob-client-v2 ethers@5",
    "check:live-imports": "node scripts/checkLiveImports.js",
    "test:state": "node scripts/testStateModules.js",
    "test:exec": "node scripts/testExecutionFlow.js",
    "test:live": "node scripts/testStateModules.js && node scripts/testExecutionFlow.js",
    "test:reliability": "node scripts/testReliabilityModules.js",
    "test:v2": "node scripts/testV2Migration.js",
    "test:paper:v2": "node scripts/testPaperModeV2.js",
    "test:paper:runtime": "node scripts/testPaperRuntime.js",
    "test:paper": "node scripts/testPaperModeV2.js && node scripts/testPaperRuntime.js",
    "verify": "node scripts/verify.js",
    "verify:quick": "node scripts/verify.js --quick",
    "verify:list": "node scripts/verify.js --list",
    "test:all": "node scripts/verify.js",
    "test:unit": "node scripts/verify.js --stage=unit",
    "test:integration": "node scripts/verify.js --stage=integration",
    "test:static": "node scripts/verify.js --stage=static",
    "check:syntax": "node scripts/checkSyntax.js",
    "check:config-defaults": "node scripts/checkConfigDefaults.js",
    "test:smart-money": "node scripts/testSmartMoneyModule.js",
    "test:price-band": "node scripts/testPriceBand.js",
    "test:sizing-caps": "node scripts/testSizingCaps.js",
    "test:hardening": "node scripts/testHardeningModules.js",
    "collect": "node scripts/collect.js",
    "backtest": "node scripts/backtest.js",
    "test:backtest": "node scripts/testBacktestModules.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "@polymarket/clob-client-v2": "^1.0.0",
    "ethers": "^5.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
